{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["agent-browser"],
  "workspaces": {
    "apps/cli": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**", "scripts/**"],
      "ignoreDependencies": [
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp"
      ]
    },
    "apps/desktop": {
      "project": ["src/**", "scripts/**"]
    },
    "tools/e2e": {
      "entry": ["src/stub-services.ts"],
      "project": ["src/**"]
    }
  }
}
