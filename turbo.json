{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "tsconfig.page.json"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:fix": {
      "cache": false
    }
  },
  "globalPassThroughEnv": ["NODE_ENV"]
}
