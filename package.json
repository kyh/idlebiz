{
  "name": "idlebiz-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev:desktop": "pnpm dev:kill && pnpm -F @repo/desktop dev",
    "dev:browser": "pnpm dev:kill && pnpm -F @repo/desktop dev:browser",
    "dev:kill": "bash apps/desktop/scripts/devkill.sh",
    "dev:web": "pnpm -F @repo/web dev",
    "e2e": "turbo run build --filter=idlebiz && pnpm -F @repo/e2e e2e",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check && turbo run format",
    "format:fix": "oxfmt --write && turbo run format:fix",
    "knip": "knip",
    "smoke:desktop": "pnpm -F @repo/desktop package && pnpm -F @repo/desktop smoke",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:rust --concurrency=${TEST_CONCURRENCY:-4}",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format && pnpm test && pnpm build"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "^8.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
