{
  "name": "idlebiz",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev:desktop": "pnpm dev:kill && turbo watch dev -F @repo/desktop...",
    "dev:kill": "bash apps/desktop/scripts/devkill.sh",
    "dev:web": "turbo watch dev -F @repo/web...",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "knip": "knip",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm -F @repo/desktop check:office && pnpm -F @repo/desktop test && pnpm build"
  },
  "devDependencies": {
    "@kyh/oxlint": "^0.2.0",
    "knip": "^6.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
