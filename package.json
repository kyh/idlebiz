{
  "name": "idlebiz",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev:desktop": "pnpm dev:kill && turbo watch dev -F @repo/desktop... --env-mode=loose",
    "dev:kill": "bash apps/desktop/scripts/devkill.sh",
    "dev:web": "turbo watch dev -F @repo/web...",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "knip": "knip",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm -F @repo/desktop check:office && pnpm -r test && pnpm build"
  },
  "devDependencies": {
    "knip": "^6.37.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "ultracite": "^7.12.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
