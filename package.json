{
  "name": "idlebiz",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "dev": "turbo watch dev --continue",
    "dev:desktop": "pnpm dev:kill && turbo watch dev -F @repo/desktop...",
    "dev:kill": "bash apps/desktop/scripts/devkill.sh",
    "dev:web": "turbo watch dev -F @repo/web...",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "knip": "knip",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm -F @repo/desktop check:office && pnpm build"
  },
  "devDependencies": {
    "knip": "^6.32.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "updateConfig": {
      "ignoreDependencies": [
        "typescript"
      ]
    }
  }
}
