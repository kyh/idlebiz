{
  // ES2023, a ceiling, for the code the page runs (apps/desktop's renderer, and @repo/domain and
  // @repo/contract, which it imports): the window is the system WebKit, at the macOS 13.5 floor
  // Safari 16.6's, and Vite lowers syntax, never stdlib, so an ES2024 builtin
  // (Promise.withResolvers, Object.groupBy) would typecheck here and then throw there.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  }
}
