    "./digest": "./src/digest.ts",
    "./domain": "./src/domain.ts",
    "./errors": "./src/errors.ts",
    "./format": "./src/format.ts",
    "./hire": "./src/hire.ts",
    "./hold-rules": "./src/hold-rules.ts",
    "./integrations": "./src/integrations.ts",
    "./json": "./src/json.ts",
    "./runners": "./src/runners.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .cache .turbo"
