{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Not `incremental`: tsc 7.0's keeps a file's last verdict when a `declare global` it sees
  // changes, so a break made there typechecks clean until its cache is cleared.
  "compilerOptions": {
    // No `lib` here: every leaf sets its own (tsconfig.page.json the page's ceiling, the node
    // programs ESNext). `target` is the floor they share, so a leaf that forgets `lib` still lands
    // on that stdlib.
    "target": "ES2023",
    "module": "Preserve",
    "moduleDetection": "force",
    "isolatedModules": true,
    // Stronger than isolatedModules: a value-import of a type-only symbol fails typecheck instead
    // of pulling runtime code into the page's bundle.
    "verbatimModuleSyntax": true,
    // No enum, namespace or parameter property: node's type stripping cannot run one, and a
    // vocabulary is an `as const` tuple.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The scripts node runs by stripping types (apps/cli/scripts, apps/desktop/scripts,
    // apps/web/scripts) must name `.ts`, and so must every module they import, a workspace one
    // reached through `@repo/*` included: bundler resolution passes an import without it, which
    // node then refuses.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Not implied by `strict`; its switch-statement sibling above is on.
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
