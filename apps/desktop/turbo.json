{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    // The page's vite build reads nothing of the shell's, and `idlebiz#build` takes this task's
    // hash, so a change to the shell alone would otherwise build the page and main again.
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "!src/shell/**", "!electron.vite.config.ts"],
      "outputs": ["dist/**"]
    },
    // The shell bundles the relay's schemas from `idlebiz/host`, so main's sources are its inputs
    // too, through the workspace dependency's hash.
    "build:shell": {
      "dependsOn": ["^topo"],
      "env": ["IDLEBIZ_TEST_PACK_ROOT"],
      "inputs": ["src/shell/**", "electron.vite.config.ts", "tsconfig.shell.json", "package.json"],
      "outputs": [".output/app/**"]
    }
  }
}
