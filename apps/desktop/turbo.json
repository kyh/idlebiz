{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!src-tauri/**", "!rust-toolchain.toml"]
    },
    "test:rust": {
      // Named inputs drop turbo's .gitignore filter, so what cargo and tauri-build write
      // (src-tauri/.gitignore) is named out here, or every build would move the hash.
      "inputs": [
        "src-tauri/**",
        "!src-tauri/target/**",
        "!src-tauri/gen/schemas/**",
        "!src-tauri/permissions/autogenerated/**",
        "!src-tauri/binaries/**",
        "rust-toolchain.toml"
      ],
      "outputs": []
    }
  }
}
