{
  "name": "@repo/desktop",
  "version": "0.0.10",
  "private": true,
  "description": "IdleBiz desktop app: a Tauri window over the office, supervising main (node) as a child process",
  "author": "kyh",
  "files": [
    ".output/main"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode main",
    "dev": "tauri dev --additional-watch-folders .output/main",
    "dev:browser": "vite --mode browser",
    "dev:page": "vite",
    "package": "node scripts/fetch-node.ts && node scripts/package.ts",
    "release:publish": "bash scripts/publish-release.sh",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json && cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test": "vitest run && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "e2e": "playwright test",
    "clean": "rm -rf .cache .output"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.79.0",
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@base-ui/react": "1.8.0",
    "@playwright/test": "^1.63.0",
    "@repo/agent-driver": "workspace:*",
    "@repo/px-kit": "workspace:*",
    "@repo/stripe-connect-protocol": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "cn": "catalog:",
    "ignore": "^7.0.10",
    "phaser": "^4.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "productName": "IdleBiz"
}
