{
  "name": "@repo/desktop",
  "version": "0.0.10",
  "private": true,
  "description": "IdleBiz desktop app: a Tauri window over the office page the server serves, supervising the server (`idlebiz serve`) as its child",
  "author": "kyh",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "tauri dev --additional-watch-folders ../cli/dist",
    "dev:browser": "vite --mode browser",
    "dev:page": "vite",
    "package": "node scripts/fetch-node.ts && node scripts/package.ts",
    "release:publish": "bash scripts/publish-release.sh",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && cargo clippy --locked --all-targets --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test": "vitest run && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "format:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "clean": "rm -rf .cache .output dist"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@repo/agent-driver": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/px-kit": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "cn": "catalog:",
    "idlebiz": "workspace:*",
    "phaser": "^4.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "productName": "IdleBiz"
}
