{
  "name": "@repo/desktop",
  "version": "0.0.7",
  "private": true,
  "description": "IdleBiz desktop app",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "build": "electron-vite build",
    "import:office-objects": "node scripts/import-office-objects.cjs && node scripts/generate-sprite-bounds.cjs",
    "generate:room-tiles": "node scripts/generate-room-builder-tiles.cjs",
    "generate:sprite-bounds": "node scripts/generate-sprite-bounds.cjs",
    "check:office": "node scripts/check-office.mjs",
    "start": "electron-vite preview",
    "release": "pnpm with-env electron-vite build && pnpm with-env electron-builder --mac --publish never",
    "release:publish": "bash scripts/publish-release.sh",
    "with-env": "dotenv -e .env --",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "clean": "rm -rf .cache .output"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.79.0",
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "@agentclientprotocol/sdk": "catalog:",
    "sharp": "^0.35.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@repo/agent-driver": "workspace:*",
    "@repo/px-kit": "workspace:*",
    "@repo/stripe-connect-protocol": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "cn": "catalog:",
    "dotenv-cli": "^11.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "phaser": "^4.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  },
  "productName": "IdleBiz"
}
