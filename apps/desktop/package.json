{
  "name": "@repo/desktop",
  "version": "0.0.10",
  "private": true,
  "description": "IdleBiz desktop app: an Electron window over the office page the server serves, supervising the server (`idlebiz serve`) as its child",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/shell/index.js",
  "scripts": {
    "build": "vite build",
    "build:shell": "electron-vite build",
    "dev": "node scripts/dev.ts",
    "dev:browser": "vite --mode browser",
    "dev:page": "vite",
    "package": "node scripts/fetch-node.ts && node scripts/package.ts",
    "release:publish": "bash scripts/publish-release.sh",
    "smoke": "node scripts/smoke-packaged.ts",
    "smoke:update": "node scripts/fetch-node.ts && node scripts/smoke-update.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.shell.json",
    "test": "vitest run",
    "clean": "rm -rf .cache .output dist"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@repo/contract": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/px-kit": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "cn": "catalog:",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "electron-vite": "^6.0.0",
    "idlebiz": "workspace:*",
    "phaser": "^4.2.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
