{
  "name": "@repo/desktop",
  "version": "0.0.4",
  "private": true,
  "description": "IdleBiz desktop app",
  "author": "kyh",
  "type": "module",
  "main": "./.output/app/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "build": "electron-vite build",
    "generate:office-objects": "node scripts/generate-office-object-catalog.cjs",
    "check:office": "node scripts/check-office-void.cjs",
    "start": "electron-vite preview",
    "release": "pnpm with-env electron-vite build && pnpm with-env electron-builder --mac --publish never",
    "release:publish": "bash scripts/publish-release.sh",
    "with-env": "dotenv -e .env --",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .cache .output",
    "check:permissions": "node --experimental-strip-types scripts/check-permission-gate.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.70.0",
    "@agentclientprotocol/codex-acp": "^1.6.2",
    "@repo/agent-driver": "workspace:*",
    "phaser": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.2.1"
  }
}
