# Apple notarization, read by `pnpm -F @repo/desktop package` (scripts/package.ts).
# Only needed to sign + publish a build; `pnpm dev:desktop` and `pnpm build` do not
# use them. These name the App Store Connect key; its .p8 itself sits at
# ~/.appstoreconnect/private_keys/AuthKey_<APPLE_API_KEY>.p8, the name Apple downloads it as,
# where the seal keeps it from every employee run. Never keep it in the checkout.
APPLE_API_KEY=
APPLE_API_ISSUER=

# The updater's signing key, made once with
# `pnpm -F @repo/desktop tauri signer generate -w ~/.tauri/idlebiz.key`, signs each release's
# update; its .pub file's contents go in src-tauri/tauri.conf.json's plugins.updater.pubkey. Only
# its password lives here, empty for a key made without one: the key itself stays at
# ~/.tauri/idlebiz.key, where the seal keeps it from every employee run. Never keep it in the
# checkout.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
