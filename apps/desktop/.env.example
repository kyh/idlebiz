# Apple notarization, read by `pnpm -F @repo/desktop package` (scripts/package.mjs).
# Only needed to sign + publish a build; `pnpm dev:desktop` and `pnpm build` do not
# use them. APPLE_API_KEY is the path to the App Store Connect .p8 key, from this
# folder — keep the key file itself out of the repo (.gitignore covers *.p8).
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
