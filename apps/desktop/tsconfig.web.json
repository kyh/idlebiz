{
  "extends": "./tsconfig.base.json",
  "include": ["src/renderer/**/*", "src/shared/**/*"],
  "compilerOptions": {
    // ES2023, a ceiling: the window is the system WebKit, at the macOS 13.5 floor Safari 16.6's,
    // and Vite lowers syntax, never stdlib, so an ES2024 builtin (Promise.withResolvers,
    // Object.groupBy) would typecheck here and then throw there
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "exclude": ["src/**/*.test.ts"]
}
